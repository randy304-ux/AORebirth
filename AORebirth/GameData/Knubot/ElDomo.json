{
    "Notes":  "El-Domo the Forest Ranger, Training Ground ruins. Redeemed side of Drake\u0027s psychic test. Generated by ddogs/tools/Build-NewbieQuests.ps1.",
    "Npcs":  [
                 "EDTH"
             ],
    "Openers":  [
                    {
                        "If":  [
                                   "HasQuest XDER"
                               ],
                        "Say":  "done_young"
                    },
                    {
                        "If":  [
                                   "HasAnyQuest XDE0,XDER"
                               ],
                        "Say":  "busy_young"
                    },
                    {
                        "Say":  "hello"
                    }
                ],
    "Replies":  {
                    "ask_young":  {
                                      "Text":  "Drake sent me. I will help the young silvertail.",
                                      "If":  [
                                                 "!HasCompletedQuest XDER",
                                                 "!HasAnyQuest XDE0,XDER",
                                                 "HasCompletedQuest XDNR"
                                             ],
                                      "Goto":  "offer_young"
                                  },
                    "take_young":  {
                                       "Text":  "I will find it.",
                                       "If":  [
                                                  "!HasCompletedQuest XDER",
                                                  "!HasAnyQuest XDE0,XDER",
                                                  "HasCompletedQuest XDNR"
                                              ],
                                       "Goto":  "give_young"
                                   },
                    "later":  {
                                  "Text":  "Maybe later.",
                                  "Goto":  "later"
                              },
                    "bye":  {
                                "Text":  "I\u0027m on it.",
                                "Goto":  "bye"
                            },
                    "more":  {
                                 "Text":  "Anything else?",
                                 "Goto":  "hello"
                             },
                    "nothing":  {
                                    "Text":  "Nothing right now, thanks.",
                                    "Goto":  "nothing"
                                }
                },
    "Lines":  {
                  "offer_young":  {
                                      "Text":  [
                                                   "The Young Silvertail is in the grove to the southwest. Target it and it will follow the scent home.",
                                                   "{delay 1}Then come back."
                                               ],
                                      "Replies":  [
                                                      "take_young",
                                                      "later"
                                                  ]
                                  },
                  "give_young":  {
                                     "Text":  [
                                                  "{givequest XDE0}",
                                                  "{delay 1}Good luck. Come back to me when it is done."
                                              ]
                                 },
                  "done_young":  {
                                     "Text":  [
                                                  "{completequest XDER}",
                                                  "The young one is safe. Tell Drake you helped the Redeemed."
                                              ],
                                     "Replies":  [
                                                     "more",
                                                     "nothing"
                                                 ]
                                 },
                  "busy_young":  {
                                     "Text":  "Target the Young Silvertail southwest of here.",
                                     "Replies":  [
                                                     "bye"
                                                 ]
                                 },
                  "later":  {
                                "Text":  "Suit yourself. I\u0027ll be here.{close}"
                            },
                  "bye":  {
                              "Text":  "Good.{close}"
                          },
                  "nothing":  {
                                  "Text":  "The herd is calmer today.{close}"
                              },
                  "hello":  {
                                "Text":  [
                                             "{delay 1}I am El-Domo. One of the silvertail young has lost the herd.",
                                             "{delay 1}If Drake sent you, I can use the help."
                                         ],
                                "Replies":  [
                                                "ask_young",
                                                "nothing"
                                            ]
                            }
              }
}