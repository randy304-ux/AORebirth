{
    "Notes":  "Vernon Godfray, hacker, Arete camp (3434x826). Retail: hacker tool + Technical Library; here the Shipping Manifest Terminal releases the chip. Generated by ddogs/tools/Build-NewbieQuests.ps1.",
    "Npcs":  [
                 "SimpleChar:78E0FC68"
             ],
    "Openers":  [
                    {
                        "If":  [
                                   "HasQuest HVGO"
                               ],
                        "Say":  "arrive"
                    },
                    {
                        "If":  [
                                   "HasAnyQuest AVGR"
                               ],
                        "Say":  "busy_chip"
                    },
                    {
                        "Say":  "hello"
                    }
                ],
    "Replies":  {
                    "ask_chip":  {
                                     "Text":  "Sarah sent me about an ID chip.",
                                     "If":  [
                                                "!HasCompletedQuest AVGR",
                                                "!HasAnyQuest AVGR",
                                                "HasCompletedQuest ASGR"
                                            ],
                                     "Goto":  "offer_chip"
                                 },
                    "take_chip":  {
                                      "Text":  "On my way.",
                                      "If":  [
                                                 "!HasCompletedQuest AVGR",
                                                 "!HasAnyQuest AVGR",
                                                 "HasCompletedQuest ASGR"
                                             ],
                                      "Goto":  "give_chip"
                                  },
                    "handin_chip":  {
                                        "Text":  "I have it right here.",
                                        "If":  [
                                                   "HasQuest AVGR"
                                               ],
                                        "Goto":  "handin_chip"
                                    },
                    "later":  {
                                  "Text":  "Maybe later.",
                                  "Goto":  "later"
                              },
                    "bye":  {
                                "Text":  "I\u0027m on it.",
                                "Goto":  "bye"
                            },
                    "more":  {
                                 "Text":  "Anything else?",
                                 "Goto":  "hello"
                             },
                    "nothing":  {
                                    "Text":  "Nothing right now, thanks.",
                                    "Goto":  "nothing"
                                }
                },
    "Lines":  {
                  "offer_chip":  {
                                     "Text":  [
                                                  "An Unprogrammed Identification Chip came in on the last cargo run. It\u0027s sitting in the Shipping Manifest Terminal down by the pad.",
                                                  "{delay 1}I\u0027ve already put a backdoor in it. Just talk to the terminal and it\u0027ll release the chip. Bring it to me."
                                              ],
                                     "Replies":  [
                                                     "take_chip",
                                                     "later"
                                                 ]
                                 },
                  "give_chip":  {
                                    "Text":  [
                                                 "{givequest AVGR}",
                                                 "{delay 1}Good luck. Come back to me when it is done."
                                             ]
                                },
                  "done_chip":  {
                                    "Text":  [
                                                 "{completequest AVGR}",
                                                 "Nice. I\u0027ll program it with your new identity.",
                                                 "{givequest HDMA}",
                                                 "{delay 1}The chip needs to be implanted. Doctor Mason can do that."
                                             ],
                                    "Replies":  [
                                                    "more",
                                                    "nothing"
                                                ]
                                },
                  "handin_chip":  {
                                      "Text":  "Let\u0027s see it, then. Put it in the trade window.{opentrade}"
                                  },
                  "busy_chip":  {
                                    "Text":  "Talk to the Shipping Manifest Terminal by the pad and bring me the Unprogrammed Identification Chip.",
                                    "Replies":  [
                                                    "handin_chip",
                                                    "bye"
                                                ]
                                },
                  "later":  {
                                "Text":  "Suit yourself. I\u0027ll be here.{close}"
                            },
                  "bye":  {
                              "Text":  "Good.{close}"
                          },
                  "arrive":  {
                                 "Text":  [
                                              "{completequest HVGO}",
                                              "Sarah sent you. Fine."
                                          ],
                                 "Replies":  [
                                                 "more",
                                                 "nothing"
                                             ]
                             },
                  "nothing":  {
                                  "Text":  "Don\u0027t mention my name to the peacekeepers.{close}"
                              },
                  "hello":  {
                                "Text":  [
                                             "{delay 1}Vernon Godfray. I don\u0027t do small talk."
                                         ],
                                "Replies":  [
                                                "ask_chip",
                                                "nothing"
                                            ]
                            }
              },
    "Trades":  {
                   "turnin_chip":  {
                                       "If":  [
                                                  "HasQuest AVGR"
                                              ],
                                       "Items":  [
                                                     {
                                                         "Hash":  "QUIC",
                                                         "Count":  1
                                                     }
                                                 ],
                                       "Goto":  "done_chip"
                                   }
               }
}