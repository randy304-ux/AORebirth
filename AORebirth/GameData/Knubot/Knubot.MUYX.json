{
  "Npcs": [
    "MUYX"
  ],
  "Openers": [
    {
      "Say": "hub"
    }
  ],
  "Replies": {
    "ey04_offer": {
      "Text": "Can I help the scientists?",
      "Goto": "ey04_description",
      "If": [
        "!HasAnyQuest EY04,EY05,EY06,EY07,EY02",
        "!quest EY04 done",
        "!quest EY02 done"
      ],
      "Source": "guide-summary"
    },
    "ey04_accept": {
      "Text": "Accept: Predator Scanning",
      "Goto": "ey04_start",
      "If": [
        "!HasAnyQuest EY04,EY05,EY06,EY07,EY02",
        "!quest EY04 done",
        "!quest EY02 done"
      ],
      "Source": "filler"
    },
    "ey04_progress": {
      "Text": "Predator Scanning: progress",
      "Goto": "ey04_progress",
      "If": [
        "HasAnyQuest EY04,EY05,EY06,EY07,EY02"
      ],
      "Source": "filler"
    },
    "scan_report": {
      "Text": "I have scanned the Predators.",
      "Goto": "scan_report",
      "If": [
        "quest EY04 done",
        "quest EY05 done",
        "quest EY06 done",
        "quest EY07 done",
        "!HasQuest EY02",
        "!quest EY02 done"
      ],
      "Source": "guide-summary"
    },
    "menu": {
      "Text": "Show available tasks.",
      "Goto": "hub",
      "Source": "filler"
    },
    "bye": {
      "Text": "Goodbye.",
      "Goto": "close",
      "Source": "filler"
    }
  },
  "Lines": {
    "ey04_description": {
      "Text": "Tag the Predators (Elysium West, 760x950) with your scanner, in order. Then come back and tell me you have scanned them. Reward: Specialization 2 (The Girl that Saw it All) Chapter 2, 20k XP and 20k credits. The mission has a 7 day timer in retail (not enforced here).",
      "Replies": [
        "ey04_accept",
        "menu",
        "bye"
      ],
      "Source": "guide-summary"
    },
    "ey04_start": {
      "Text": "{givequest EY04}{givequest EY05}{givequest EY06}{givequest EY07}The assignment is in your journal.{close}",
      "Replies": [
        "menu",
        "bye"
      ],
      "Source": "filler"
    },
    "ey04_progress": {
      "Text": "Tag the Predators (Elysium West, 760x950) with your scanner, in order. Then come back and tell me you have scanned them. Reward: Specialization 2 (The Girl that Saw it All) Chapter 2, 20k XP and 20k credits. The mission has a 7 day timer in retail (not enforced here).",
      "Replies": [
        "menu",
        "bye"
      ],
      "Source": "guide-summary"
    },
    "scan_report": {
      "Text": "{givequest EY02}Well done. Target me once more to hand in the scan.",
      "Replies": [
        "menu",
        "bye"
      ],
      "Source": "filler"
    },
    "hub": {
      "Text": "Choose a task or report your progress.",
      "Replies": [
        "ey04_offer",
        "ey04_progress",
        "scan_report",
        "bye"
      ],
      "Source": "filler"
    }
  },
  "Trades": {}
