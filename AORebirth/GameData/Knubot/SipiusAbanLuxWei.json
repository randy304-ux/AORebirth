                                    "Goto":  "combine"
                                },
                    "nothing":  {
                                    "Text":  "Nothing right now, thanks.",
                                    "Goto":  "nothing"
                                }
                },
    "Lines":  {
                  "offer_souls":  {
                                      "Text":  [
                                                   "Three Dreaming Silvertails wander north of Frontier Bridge. Free them, carrying the graced Analyzer.",
                                                   "{delay 1}Then give the Analyzer back to me."
                                               ],
                                      "Replies":  [
                                                      "take_souls",
                                                      "later"
                                                  ]
                                  },
                  "give_souls":  {
                                     "Text":  [
                                                  "{givequest GAL0}",
                                                  "{delay 1}Good luck. Come back to me when it is done."
                                              ]
                                 },
                  "done_souls":  {
                                     "Text":  [
                                                  "{completequest GALR}",
                                                  "Three souls saved. Aban is pleased, and so am I. This key is yours: the Garden of Aban is open to you."
                                              ],
                                     "Replies":  [
                                                     "more",
                                                     "nothing"
                                                 ]
                                 },
                  "handin_souls":  {
                                       "Text":  "Let\u0027s see it, then. Put it in the trade window.{opentrade}"
                                   },
                  "busy_souls":  {
                                     "Text":  "Free three Dreaming Silvertails, then give me back the graced Analyzer.",
                                     "Replies":  [
                                                     "handin_souls",
                                                     "bye"
                                                 ]
                                 },
                  "later":  {
                                "Text":  "Suit yourself. I\u0027ll be here.{close}"
                            },
                  "bye":  {
                              "Text":  "Good.{close}"
                          },
                  "arrive":  {
                                 "Text":  [
                                              "{completequest HGAL}",
                                              "Fala sent you. Show me the device."
                                          ],
                                 "Replies":  [
                                                 "more",
                                                 "nothing"
                                             ]
                             },
                  "combine":  {
                                  "Text":  "Give me the Ancient Device together with an Insignia of Aban.{opentrade}"
                              },
                  "graced":  {
                                 "Text":  [
                                              "{spawn GAPG 1}",
                                              "It is done: an Ancient Pattern Analyzer, graced by the Faithful.",
                                              "{delay 1}Now save three souls. The Dreaming Silvertails north of Frontier Bridge are lost; free them, then return the Analyzer to me."
                                          ],
                                 "Fail":  "full",
                                 "Replies":  [
                                                 "more",
                                                 "nothing"
                                             ]
                             },
                  "full":  {
                               "Text":  "Your hands are full. Make some room in your inventory first.{close}"
                           },
                  "nothing":  {
                                  "Text":  "Peace be with you.{close}"
                              },
                  "hello":  {
                                "Text":  [
                                             "{delay 1}The garden is at peace. May you find it too."
                                         ],
                                "Replies":  [
                                                "ask_souls",
                                                "combine",
                                                "nothing"
                                            ]
                            }
              },
    "Trades":  {
