                                                 "!HasCompletedQuest GALR",
                                                 "!HasAnyQuest GAL0,GALR",
                                                 "HasCompletedQuest GAFR"
                                             ],
                                      "Goto":  "offer_souls"
                                  },
                    "take_souls":  {
                                       "Text":  "I will save them.",
                                       "If":  [
                                                  "!HasCompletedQuest GALR",
                                                  "!HasAnyQuest GAL0,GALR",
                                                  "HasCompletedQuest GAFR"
