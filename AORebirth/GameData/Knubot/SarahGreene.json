                          },
                  "arrive":  {
                                 "Text":  [
                                              "{completequest HSAG}",
                                              "Marco sent you? Of course he did."
                                          ],
                                 "Replies":  [
                                                 "more",
                                                 "nothing"
                                             ]
                             },
                  "nothing":  {
                                  "Text":  "See you around!{close}"
                              },
                  "hello":  {
                                "Text":  [
                                             "{delay 1}Hi there! I\u0027m Sarah. I make armor, good armor."
