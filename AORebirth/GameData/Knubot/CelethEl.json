{
    "Notes":  "Celeth-El, the Crystal Guardian. Unredeemed side of Drake\u0027s psychic test. Talkable. Generated by ddogs/tools/Build-NewbieQuests.ps1.",
    "Npcs":  [
                 "CTTC"
             ],
    "Openers":  [
                    {
                        "If":  [
                                   "HasQuest XDCR"
                               ],
                        "Say":  "done_mare"
                    },
                    {
                        "If":  [
                                   "HasAnyQuest XDC0,XDCR"
                               ],
                        "Say":  "busy_mare"
                    },
                    {
                        "Say":  "hello"
                    }
                ],
    "Replies":  {
                    "ask_mare":  {
                                     "Text":  "I will deal with the Silvertail Mare.",
                                     "If":  [
                                                "!HasCompletedQuest XDCR",
                                                "!HasAnyQuest XDC0,XDCR",
                                                "HasCompletedQuest XDNR"
                                            ],
                                     "Goto":  "offer_mare"
                                 },
                    "take_mare":  {
                                      "Text":  "Consider it done.",
                                      "If":  [
                                                 "!HasCompletedQuest XDCR",
                                                 "!HasAnyQuest XDC0,XDCR",
                                                 "HasCompletedQuest XDNR"
                                             ],
                                      "Goto":  "give_mare"
                                  },
                    "later":  {
                                  "Text":  "Maybe later.",
                                  "Goto":  "later"
                              },
                    "bye":  {
                                "Text":  "I\u0027m on it.",
                                "Goto":  "bye"
                            },
                    "more":  {
                                 "Text":  "Anything else?",
                                 "Goto":  "hello"
                             },
                    "nothing":  {
                                    "Text":  "Nothing right now, thanks.",
                                    "Goto":  "nothing"
                                }
                },
    "Lines":  {
                  "offer_mare":  {
                                     "Text":  "She stands just outside. Kill her, then come back. I will return your bracer... changed.",
                                     "Replies":  [
                                                     "take_mare",
                                                     "later"
                                                 ]
                                 },
                  "give_mare":  {
                                    "Text":  [
                                                 "{givequest XDC0}",
                                                 "{delay 1}Good luck. Come back to me when it is done."
                                             ]
                                },
                  "done_mare":  {
                                    "Text":  [
                                                 "{completequest XDCR}",
                                                 "It is scourged. The bracer is stronger, and Drake will not accept this one. Ask him for another, and tell him the Chosen are satisfied."
                                             ],
                                    "Replies":  [
                                                    "more",
                                                    "nothing"
                                                ]
                                },
                  "busy_mare":  {
                                    "Text":  "Kill the Silvertail Mare.",
                                    "Replies":  [
                                                    "bye"
                                                ]
                                },
                  "later":  {
                                "Text":  "Suit yourself. I\u0027ll be here.{close}"
                            },
                  "bye":  {
                              "Text":  "Good.{close}"
                          },
                  "nothing":  {
                                  "Text":  "The crystals are quiet.{close}"
                              },
                  "hello":  {
                                "Text":  [
                                             "{delay 1}Celeth-El. You wear Jobe\u0027s bracer. Give me a moment with it.",
                                             "{delay 1}There is a Silvertail Mare crying outside this cleft. Silence her."
                                         ],
                                "Replies":  [
                                                "ask_mare",
                                                "nothing"
                                            ]
                            }
              }
}