{
    "Notes":  "Marco Spida (3408x831). Guide: buy your profession nano container from him and open it. 1120 credits, up to 2229 xp, Composite Attribute Boost. Generated by ddogs/tools/Build-NewbieQuests.ps1.",
    "Npcs":  [
                 "ONRP"
             ],
    "Openers":  [
                    {
                        "If":  [
                                   "HasQuest HMPS"
                               ],
                        "Say":  "arrive"
                    },
                    {
                        "If":  [
                                   "HasQuest AMPR"
                               ],
                        "Say":  "done_nano"
                    },
                    {
                        "If":  [
                                   "HasAnyQuest AMPR"
                               ],
                        "Say":  "busy_nano"
                    },
                    {
                        "Say":  "hello"
                    }
                ],
    "Replies":  {
                    "ask_nano":  {
                                     "Text":  "Stan said you sell nanos.",
                                     "If":  [
                                                "!HasCompletedQuest AMPR",
                                                "!HasAnyQuest AMPR",
                                                "HasCompletedQuest ASTR"
                                            ],
                                     "Goto":  "offer_nano"
                                 },
                    "take_nano":  {
                                      "Text":  "I will open it.",
                                      "If":  [
                                                 "!HasCompletedQuest AMPR",
                                                 "!HasAnyQuest AMPR",
                                                 "HasCompletedQuest ASTR"
                                             ],
                                      "Goto":  "give_nano"
                                  },
                    "later":  {
                                  "Text":  "Maybe later.",
                                  "Goto":  "later"
                              },
                    "bye":  {
                                "Text":  "I\u0027m on it.",
                                "Goto":  "bye"
                            },
                    "more":  {
                                 "Text":  "Anything else?",
                                 "Goto":  "hello"
                             },
                    "nothing":  {
                                    "Text":  "Nothing right now, thanks.",
                                    "Goto":  "nothing"
                                }
                },
    "Lines":  {
                  "offer_nano":  {
                                     "Text":  [
                                                  "Buy the nano container for your profession and open it. My counter is not a full shop yet, so I will hand you the container.",
                                                  "{delay 1}Open it, then tell me."
                                              ],
                                     "Replies":  [
                                                     "take_nano",
                                                     "later"
                                                 ]
                                 },
                  "give_nano":  {
                                    "Text":  [
                                                 "{spawn QNPC 1}",
                                                 "{givequest AMPR}",
                                                 "{delay 1}Good luck. Come back to me when it is done."
                                             ]
                                },
                  "done_nano":  {
                                    "Text":  [
                                                 "{completequest AMPR}",
                                                 "Opened. Here is a Composite Attribute Boost crystal. Sarah Greene is next.",
                                                 "{givequest HSAG}",
                                                 "{delay 1}Sarah Greene, the armorsmith, about 3471 by 841."
                                             ],
                                    "Replies":  [
                                                    "more",
                                                    "nothing"
                                                ]
                                },
                  "busy_nano":  {
                                    "Text":  "Open the profession nano container Marco gives you.",
                                    "Replies":  [
                                                    "bye"
                                                ]
                                },
                  "later":  {
                                "Text":  "Suit yourself. I\u0027ll be here.{close}"
                            },
                  "bye":  {
                              "Text":  "Good.{close}"
                          },
                  "arrive":  {
                                 "Text":  [
                                              "{completequest HMPS}",
                                              "Stan sent you. I can see it."
                                          ],
                                 "Replies":  [
                                                 "more",
                                                 "nothing"
                                             ]
                             },
                  "nothing":  {
                                  "Text":  "The can I handed you is the Soldier nanoprogram container. The other professions have their own can on retail. The crystal is the same.{close}"
                              },
                  "hello":  {
                                "Text":  [
                                             "{delay 1}Marco Spida. Nanos, for people who can pay."
                                         ],
                                "Replies":  [
                                                "ask_nano",
                                                "nothing"
                                            ]
                            }
              }
}