{
    "Notes":  "Sabina Florenta, Old Frontier (885x1575). Retail: blood samples spawned on kill; here each Predator Striker kill counts. Generated by ddogs/tools/Build-NewbieQuests.ps1.",
    "Npcs":  [
                 "SBFN"
             ],
    "Openers":  [
                    {
                        "If":  [
                                   "HasAnyQuest DSB0,DSBR"
                               ],
                        "Say":  "busy_blood"
                    },
                    {
                        "Say":  "hello"
                    }
                ],
    "Replies":  {
                    "ask_blood":  {
                                      "Text":  "Can I help?",
                                      "If":  [
                                                 "!HasCompletedQuest DSBR",
                                                 "!HasAnyQuest DSB0,DSBR"
                                             ],
                                      "Goto":  "offer_blood"
                                  },
                    "take_blood":  {
                                       "Text":  "Blood donation, coming up.",
                                       "If":  [
                                                  "!HasCompletedQuest DSBR",
                                                  "!HasAnyQuest DSB0,DSBR"
                                              ],
                                       "Goto":  "give_blood"
                                   },
                    "later":  {
                                  "Text":  "Maybe later.",
                                  "Goto":  "later"
                              },
                    "bye":  {
                                "Text":  "I\u0027m on it.",
                                "Goto":  "bye"
                            },
                    "nothing":  {
                                    "Text":  "Nothing right now, thanks.",
                                    "Goto":  "nothing"
                                }
                },
    "Lines":  {
                  "offer_blood":  {
                                      "Text":  "I need six blood samples. Kill Predator Strikers a bit toward Nascence Frontier and to the left.",
                                      "Replies":  [
                                                      "take_blood",
                                                      "later"
                                                  ]
                                  },
                  "give_blood":  {
                                     "Text":  [
                                                  "{givequest DSB0}",
                                                  "{delay 1}Good luck. Come back to me when it is done."
                                              ]
                                 },
                  "busy_blood":  {
                                     "Text":  "Six Predator Strikers.",
                                     "Replies":  [
                                                     "bye"
                                                 ]
                                 },
                  "later":  {
                                "Text":  "Suit yourself. I\u0027ll be here.{close}"
                            },
                  "bye":  {
                              "Text":  "Good.{close}"
                          },
                  "nothing":  {
                                  "Text":  "Thank you so much for your help!{close}"
                              },
                  "hello":  {
                                "Text":  [
                                             "{delay 1}Hello! I\u0027m researching the Predator Strikers. Their blood is fascinating."
                                         ],
                                "Replies":  [
                                                "ask_blood",
                                                "nothing"
                                            ]
                            }
              }
}