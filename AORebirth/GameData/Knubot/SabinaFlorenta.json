{
    "Notes":  "Sabina Florenta, Old Frontier (885x1575). Retail: blood samples spawned on kill; samples drop from Predator Strikers (50%) and are handed in by trade. Generated by ddogs/tools/Build-NewbieQuests.ps1.",
    "Npcs":  [
                 "SBFN"
             ],
    "Openers":  [
                    {
                        "If":  [
                                   "HasAnyQuest DSBR"
                               ],
                        "Say":  "busy_blood"
                    },
                    {
                        "Say":  "hello"
                    }
                ],
    "Replies":  {
                    "ask_blood":  {
                                      "Text":  "Can I help?",
                                      "If":  [
                                                 "!HasCompletedQuest DSBR",
                                                 "!HasAnyQuest DSBR"
                                             ],
                                      "Goto":  "offer_blood"
                                  },
                    "take_blood":  {
                                       "Text":  "Blood donation, coming up.",
                                       "If":  [
                                                  "!HasCompletedQuest DSBR",
                                                  "!HasAnyQuest DSBR"
                                              ],
                                       "Goto":  "give_blood"
                                   },
                    "handin_blood":  {
                                         "Text":  "I have it right here.",
                                         "If":  [
                                                    "HasQuest DSBR"
                                                ],
                                         "Goto":  "handin_blood"
                                     },
                    "later":  {
                                  "Text":  "Maybe later.",
                                  "Goto":  "later"
                              },
                    "bye":  {
                                "Text":  "I\u0027m on it.",
                                "Goto":  "bye"
                            },
                    "more":  {
                                 "Text":  "Anything else?",
                                 "Goto":  "hello"
                             },
                    "nothing":  {
                                    "Text":  "Nothing right now, thanks.",
                                    "Goto":  "nothing"
                                }
                },
    "Lines":  {
                  "offer_blood":  {
                                      "Text":  "I need six Predator Blood Samples. Predator Strikers carry them; you\u0027ll find them a bit toward Nascence Frontier and to the left.",
                                      "Replies":  [
                                                      "take_blood",
                                                      "later"
                                                  ]
                                  },
                  "give_blood":  {
                                     "Text":  [
                                                  "{givequest DSBR}",
                                                  "{delay 1}Good luck. Come back to me when it is done."
                                              ]
                                 },
                  "done_blood":  {
                                     "Text":  [
                                                  "{completequest DSBR}",
                                                  "Wonderful, six perfect samples!"
                                              ],
                                     "Replies":  [
                                                     "more",
                                                     "nothing"
                                                 ]
                                 },
                  "handin_blood":  {
                                       "Text":  "Let\u0027s see it, then. Put it in the trade window.{opentrade}"
                                   },
                  "busy_blood":  {
                                     "Text":  "Six Predator Blood Samples, from Predator Strikers.",
                                     "Replies":  [
                                                     "handin_blood",
                                                     "bye"
                                                 ]
                                 },
                  "later":  {
                                "Text":  "Suit yourself. I\u0027ll be here.{close}"
                            },
                  "bye":  {
                              "Text":  "Good.{close}"
                          },
                  "nothing":  {
                                  "Text":  "Thank you so much for your help!{close}"
                              },
                  "hello":  {
                                "Text":  [
                                             "{delay 1}Hello! I\u0027m researching the Predator Strikers. Their blood is fascinating."
                                         ],
                                "Replies":  [
                                                "ask_blood",
                                                "nothing"
                                            ]
                            }
              },
    "Trades":  {
                   "turnin_blood":  {
                                        "If":  [
                                                   "HasQuest DSBR"
                                               ],
                                        "Items":  [
                                                      {
                                                          "Hash":  "QPBS",
                                                          "Count":  6
                                                      }
                                                  ],
                                        "Goto":  "done_blood"
                                    }
               }
}