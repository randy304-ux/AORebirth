{
  "Npcs": [
    "PN03"
  ],
  "Openers": [
    {
      "If": [
        "quest XK04 active"
      ],
      "Say": "offer_active"
    },
    {
      "If": [
        "HasAnyQuest XK05,XK06,XK07"
      ],
      "Say": "offer_repeat"
    }
  ],
  "Lines": {
    "offer_active": {
      "Text": "Environmental Test Unit 2 is running today's ice measure.",
      "Replies": [
        "ask",
        "bye"
      ],
      "Source": "filler"
    },
    "offer_repeat": {
      "Text": "Environmental Test Unit 2 can repeat today's ice measure.",
      "Replies": [
        "ask_repeat",
        "bye"
      ],
      "Source": "filler"
    },
    "thickness": {
      "Text": "Today's ice thickness is 104.32. Remember that number for Founding Glacier Five. {completequest XK04}",
      "Replies": [
        "bye"
      ],
      "Source": "filler"
    },
    "thickness_repeat": {
      "Text": "Today's ice thickness is 104.32.",
      "Replies": [
        "bye"
      ],
      "Source": "filler"
    }
  },
  "Replies": {
    "bye": {
      "Text": "I will go.",
      "Goto": "close",
      "Source": "filler"
    },
    "ask": {
      "Text": "What is today's ice thickness?",
      "Goto": "thickness",
      "Source": "filler"
    },
    "ask_repeat": {
      "Text": "What is today's ice thickness?",
      "Goto": "thickness_repeat",
      "Source": "filler"
    }
  }
}
