{
    "Notes":  "Desmond Calitri (3605x827). Repeatable side job. Generated by ddogs/tools/Build-NewbieQuests.ps1.",
    "Npcs":  [
                 "SimpleChar:78E0FC77"
             ],
    "Openers":  [
                    {
                        "If":  [
                                   "HasQuest ADCR"
                               ],
                        "Say":  "done_dockers"
                    },
                    {
                        "If":  [
                                   "HasAnyQuest ADC0,ADCR"
                               ],
                        "Say":  "busy_dockers"
                    },
                    {
                        "Say":  "hello"
                    }
                ],
    "Replies":  {
                    "ask_dockers":  {
                                        "Text":  "Want me to deal with them?",
                                        "If":  [
                                                   "!HasAnyQuest ADC0,ADCR"
                                               ],
                                        "Goto":  "offer_dockers"
                                    },
                    "take_dockers":  {
                                         "Text":  "Will do.",
                                         "If":  [
                                                    "!HasAnyQuest ADC0,ADCR"
                                                ],
                                         "Goto":  "give_dockers"
                                     },
                    "later":  {
                                  "Text":  "Maybe later.",
                                  "Goto":  "later"
                              },
                    "bye":  {
                                "Text":  "I\u0027m on it.",
                                "Goto":  "bye"
                            },
                    "more":  {
                                 "Text":  "Anything else?",
                                 "Goto":  "hello"
                             },
                    "nothing":  {
                                    "Text":  "Nothing right now, thanks.",
                                    "Goto":  "nothing"
                                }
                },
    "Lines":  {
                  "offer_dockers":  {
                                        "Text":  "Four 32-V Dockers. Shut them down.",
                                        "Replies":  [
                                                        "take_dockers",
                                                        "later"
                                                    ]
                                    },
                  "give_dockers":  {
                                       "Text":  [
                                                    "{givequest ADC0}",
                                                    "{delay 1}Good luck. Come back to me when it is done."
                                                ]
                                   },
                  "done_dockers":  {
                                       "Text":  [
                                                    "{completequest ADCR}",
                                                    "Nice work."
                                                ],
                                       "Replies":  [
                                                       "more",
                                                       "nothing"
                                                   ]
                                   },
                  "busy_dockers":  {
                                       "Text":  "Four 32-V Dockers.",
                                       "Replies":  [
                                                       "bye"
                                                   ]
                                   },
                  "later":  {
                                "Text":  "Suit yourself. I\u0027ll be here.{close}"
                            },
                  "bye":  {
                              "Text":  "Good.{close}"
                          },
                  "nothing":  {
                                  "Text":  "Later.{close}"
                              },
                  "hello":  {
                                "Text":  [
                                             "{delay 1}Desmond Calitri. Those docker robots have stopped listening to anyone."
                                         ],
                                "Replies":  [
                                                "ask_dockers",
                                                "nothing"
                                            ]
                            }
              }
}