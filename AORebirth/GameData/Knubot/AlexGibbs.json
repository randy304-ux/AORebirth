{
    "Notes":  "Alex Gibbs, shuttle pad (3521x857). Takes Flint\u0027s Bio Analyzing Computer. Generated by ddogs/tools/Build-NewbieQuests.ps1.",
    "Npcs":  [
                 "SimpleChar:78E0FC61"
             ],
    "Openers":  [
                    {
                        "If":  [
                                   "HasQuest AFLR"
                               ],
                        "Say":  "bac"
                    },
                    {
                        "If":  [
                                   "HasQuest AAGR"
                               ],
                        "Say":  "done_waste"
                    },
                    {
                        "If":  [
                                   "HasAnyQuest AAG0,AAGR"
                               ],
                        "Say":  "busy_waste"
                    },
                    {
                        "Say":  "hello"
                    }
                ],
    "Replies":  {
                    "ask_waste":  {
                                      "Text":  "Can I help with the Waste Collectors?",
                                      "If":  [
                                                 "!HasAnyQuest AAG0,AAGR"
                                             ],
                                      "Goto":  "offer_waste"
                                  },
                    "take_waste":  {
                                       "Text":  "Sure.",
                                       "If":  [
                                                  "!HasAnyQuest AAG0,AAGR"
                                              ],
                                       "Goto":  "give_waste"
                                   },
                    "later":  {
                                  "Text":  "Maybe later.",
                                  "Goto":  "later"
                              },
                    "bye":  {
                                "Text":  "I\u0027m on it.",
                                "Goto":  "bye"
                            },
                    "more":  {
                                 "Text":  "Anything else?",
                                 "Goto":  "hello"
                             },
                    "nothing":  {
                                    "Text":  "Nothing right now, thanks.",
                                    "Goto":  "nothing"
                                }
                },
    "Lines":  {
                  "offer_waste":  {
                                      "Text":  "Five of them. They\u0027re all over the landing.",
                                      "Replies":  [
                                                      "take_waste",
                                                      "later"
                                                  ]
                                  },
                  "give_waste":  {
                                     "Text":  [
                                                  "{givequest AAG0}",
                                                  "{delay 1}Good luck. Come back to me when it is done."
                                              ]
                                 },
                  "done_waste":  {
                                     "Text":  [
                                                  "{completequest AAGR}",
                                                  "Thanks. That keeps the pad clean for a while."
                                              ],
                                     "Replies":  [
                                                     "more",
                                                     "nothing"
                                                 ]
                                 },
                  "busy_waste":  {
                                     "Text":  "Five Waste Collectors.",
                                     "Replies":  [
                                                     "bye"
                                                 ]
                                 },
                  "later":  {
                                "Text":  "Suit yourself. I\u0027ll be here.{close}"
                            },
                  "bye":  {
                              "Text":  "Good.{close}"
                          },
                  "bac":  {
                              "Text":  "Flint sent you? If you found a Bio Analyzing Computer, hand it over.{opentrade}"
                          },
                  "bac_done":  {
                                   "Text":  [
                                                "{completequest AFLR}",
                                                "This is exactly what I needed. Your ID card is under way.",
                                                "{givequest HSTG}",
                                                "{delay 1}You\u0027ll need more parts. Stan Goodman in the camp is a purveyor of recently used merchandise. Go talk to him."
                                            ],
                                   "Replies":  [
                                                   "more",
                                                   "nothing"
                                               ]
                               },
                  "nothing":  {
                                  "Text":  "Come back if you need anything.{close}"
                              },
                  "hello":  {
                                "Text":  [
                                             "{delay 1}Alex Gibbs. I put together identities for people who need them.",
                                             "{delay 1}And I always need the Waste Collectors kept off my pad."
                                         ],
                                "Replies":  [
                                                "ask_waste",
                                                "nothing"
                                            ]
                            }
              },
    "Trades":  {
                   "bac":  {
                               "If":  [
                                          "HasQuest AFLR"
                                      ],
                               "Items":  [
                                             {
                                                 "Hash":  "QBAC",
                                                 "Count":  1
                                             }
                                         ],
                               "Goto":  "bac_done"
                           }
               }
}