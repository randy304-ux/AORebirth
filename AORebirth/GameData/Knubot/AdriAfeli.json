{
    "Notes":  "Adri Afeli, weapon tinkerer (900x840). Retail upgraded the starter weapon from the five parts; here the parts quest pays XP and credits only. Generated by ddogs/tools/Build-NewbieQuests.ps1.",
    "Npcs":  [
                 "ADAF"
             ],
    "Openers":  [
                    {
                        "If":  [
                                   "HasAnyQuest DAP0,DAP1,DAP2,DAP3,DAP4,DAPR"
                               ],
                        "Say":  "busy_parts"
                    },
                    {
                        "If":  [
                                   "HasAnyQuest DAD0,DAD1,DAD2,DAD3,DADR"
                               ],
                        "Say":  "busy_droids"
                    },
                    {
                        "Say":  "hello"
                    }
                ],
    "Replies":  {
                    "ask_parts":  {
                                      "Text":  "What parts do you need?",
                                      "If":  [
                                                 "!HasCompletedQuest DAPR",
                                                 "!HasAnyQuest DAP0,DAP1,DAP2,DAP3,DAP4,DAPR"
                                             ],
                                      "Goto":  "offer_parts"
                                  },
                    "take_parts":  {
                                       "Text":  "I\u0027ll get them.",
                                       "If":  [
                                                  "!HasCompletedQuest DAPR",
                                                  "!HasAnyQuest DAP0,DAP1,DAP2,DAP3,DAP4,DAPR"
                                              ],
                                       "Goto":  "give_parts"
                                   },
                    "ask_droids":  {
                                       "Text":  "Anything else?",
                                       "If":  [
                                                  "!HasCompletedQuest DADR",
                                                  "!HasAnyQuest DAD0,DAD1,DAD2,DAD3,DADR",
                                                  "HasCompletedQuest DAPR"
                                              ],
                                       "Goto":  "offer_droids"
                                   },
                    "take_droids":  {
                                        "Text":  "Consider them scrap.",
                                        "If":  [
                                                   "!HasCompletedQuest DADR",
                                                   "!HasAnyQuest DAD0,DAD1,DAD2,DAD3,DADR",
                                                   "HasCompletedQuest DAPR"
                                               ],
                                        "Goto":  "give_droids"
                                    },
                    "later":  {
                                  "Text":  "Maybe later.",
                                  "Goto":  "later"
                              },
                    "bye":  {
                                "Text":  "I\u0027m on it.",
                                "Goto":  "bye"
                            },
                    "nothing":  {
                                    "Text":  "Nothing right now, thanks.",
                                    "Goto":  "nothing"
                                }
                },
    "Lines":  {
                  "offer_parts":  {
                                      "Text":  [
                                                   "A Power Supply from a Cargo Droid, a Compression Chamber from a Waste Collector, Stalker Limbs, Rollerrat Intestines, and Bone Plates from a Cliff Malle.",
                                                   "{delay 1}Take one of each down and bring me what\u0027s left."
                                               ],
                                      "Replies":  [
                                                      "take_parts",
                                                      "later"
                                                  ]
                                  },
                  "give_parts":  {
                                     "Text":  [
                                                  "{givequest DAP0}",
                                                  "{delay 1}Good luck. Come back to me when it is done."
                                              ]
                                 },
                  "busy_parts":  {
                                     "Text":  "Cargo Droid, Waste Collector, Tropical Stalker, Rollerrat and Cliff Malle. One of each.",
                                     "Replies":  [
                                                     "bye"
                                                 ]
                                 },
                  "offer_droids":  {
                                       "Text":  [
                                                    "The machines around the cargo area have gone haywire. Three Cargo Droids, three Waste Collectors, and their two leaders: the Android Leader and the Junk Bot Leader.",
                                                    "{delay 1}Shut them down and I have a backpack with your name on it."
                                                ],
                                       "Replies":  [
                                                       "take_droids",
                                                       "later"
                                                   ]
                                   },
                  "give_droids":  {
                                      "Text":  [
                                                   "{givequest DAD0}",
                                                   "{delay 1}Good luck. Come back to me when it is done."
                                               ]
                                  },
                  "busy_droids":  {
                                      "Text":  "Three Cargo Droids, three Waste Collectors, then the Android and Junk Bot leaders.",
                                      "Replies":  [
                                                      "bye"
                                                  ]
                                  },
                  "later":  {
                                "Text":  "Suit yourself. I\u0027ll be here.{close}"
                            },
                  "bye":  {
                              "Text":  "Good.{close}"
                          },
                  "nothing":  {
                                  "Text":  "That\u0027s all I have. Go see Manager Travis Molen up on the platform, he always needs people.{close}"
                              },
                  "hello":  {
                                "Text":  [
                                             "{delay 1}A fresh face! You look like someone who appreciates a good weapon.",
                                             "{delay 1}I tinker. Starter guns, mostly. With the right parts I can make yours sing."
                                         ],
                                "Replies":  [
                                                "ask_parts",
                                                "ask_droids",
                                                "nothing"
                                            ]
                            }
              }
}