{
    "Notes":  "Adri Afeli, weapon tinkerer (900x840). Parts drop from Cargo Droids, Tropical Stalkers and Rollerrats (35%) and are handed in by trade; the retail weapon upgrade itself is not built. Generated by ddogs/tools/Build-NewbieQuests.ps1.",
    "Npcs":  [
                 "ADAF"
             ],
    "Openers":  [
                    {
                        "If":  [
                                   "HasAnyQuest DAPR"
                               ],
                        "Say":  "busy_parts"
                    },
                    {
                        "If":  [
                                   "HasAnyQuest DAD0,DAD1,DAD2,DAD3,DADR"
                               ],
                        "Say":  "busy_droids"
                    },
                    {
                        "Say":  "hello"
                    }
                ],
    "Replies":  {
                    "ask_parts":  {
                                      "Text":  "What parts do you need?",
                                      "If":  [
                                                 "!HasCompletedQuest DAPR",
                                                 "!HasAnyQuest DAPR"
                                             ],
                                      "Goto":  "offer_parts"
                                  },
                    "take_parts":  {
                                       "Text":  "I\u0027ll get them.",
                                       "If":  [
                                                  "!HasCompletedQuest DAPR",
                                                  "!HasAnyQuest DAPR"
                                              ],
                                       "Goto":  "give_parts"
                                   },
                    "handin_parts":  {
                                         "Text":  "I have it right here.",
                                         "If":  [
                                                    "HasQuest DAPR"
                                                ],
                                         "Goto":  "handin_parts"
                                     },
                    "ask_droids":  {
                                       "Text":  "Anything else?",
                                       "If":  [
                                                  "!HasCompletedQuest DADR",
                                                  "!HasAnyQuest DAD0,DAD1,DAD2,DAD3,DADR",
                                                  "HasCompletedQuest DAPR"
                                              ],
                                       "Goto":  "offer_droids"
                                   },
                    "take_droids":  {
                                        "Text":  "Consider them scrap.",
                                        "If":  [
                                                   "!HasCompletedQuest DADR",
                                                   "!HasAnyQuest DAD0,DAD1,DAD2,DAD3,DADR",
                                                   "HasCompletedQuest DAPR"
                                               ],
                                        "Goto":  "give_droids"
                                    },
                    "later":  {
                                  "Text":  "Maybe later.",
                                  "Goto":  "later"
                              },
                    "bye":  {
                                "Text":  "I\u0027m on it.",
                                "Goto":  "bye"
                            },
                    "more":  {
                                 "Text":  "Anything else?",
                                 "Goto":  "hello"
                             },
                    "nothing":  {
                                    "Text":  "Nothing right now, thanks.",
                                    "Goto":  "nothing"
                                }
                },
    "Lines":  {
                  "offer_parts":  {
                                      "Text":  [
                                                   "A Power Supply from a Cargo Droid, a Stalker Limb from a Tropical Stalker and Rollerrat Intestines from a Stowaway Rollerrat.",
                                                   "{delay 1}They don\u0027t all carry what I need, so you may have to take down a few. Bring me all three together."
                                               ],
                                      "Replies":  [
                                                      "take_parts",
                                                      "later"
                                                  ]
                                  },
                  "give_parts":  {
                                     "Text":  [
                                                  "{givequest DAPR}",
                                                  "{delay 1}Good luck. Come back to me when it is done."
                                              ]
                                 },
                  "done_parts":  {
                                     "Text":  [
                                                  "{completequest DAPR}",
                                                  "Perfect, these will do nicely."
                                              ],
                                     "Replies":  [
                                                     "more",
                                                     "nothing"
                                                 ]
                                 },
                  "handin_parts":  {
                                       "Text":  "Let\u0027s see it, then. Put it in the trade window.{opentrade}"
                                   },
                  "busy_parts":  {
                                     "Text":  "A Power Supply (Cargo Droids), a Stalker Limb (Tropical Stalkers) and Rollerrat Intestines (Rollerrats). All three at once.",
                                     "Replies":  [
                                                     "handin_parts",
                                                     "bye"
                                                 ]
                                 },
                  "offer_droids":  {
                                       "Text":  [
                                                    "The machines around the cargo area have gone haywire. Three Cargo Droids, three Waste Collectors, and their two leaders: the Android Leader and the Junk Bot Leader.",
                                                    "{delay 1}Shut them down and I have a backpack with your name on it."
                                                ],
                                       "Replies":  [
                                                       "take_droids",
                                                       "later"
                                                   ]
                                   },
                  "give_droids":  {
                                      "Text":  [
                                                   "{givequest DAD0}",
                                                   "{delay 1}Good luck. Come back to me when it is done."
                                               ]
                                  },
                  "busy_droids":  {
                                      "Text":  "Three Cargo Droids, three Waste Collectors, then the Android and Junk Bot leaders.",
                                      "Replies":  [
                                                      "bye"
                                                  ]
                                  },
                  "later":  {
                                "Text":  "Suit yourself. I\u0027ll be here.{close}"
                            },
                  "bye":  {
                              "Text":  "Good.{close}"
                          },
                  "nothing":  {
                                  "Text":  "That\u0027s all I have. Go see Manager Travis Molen up on the platform, he always needs people.{close}"
                              },
                  "hello":  {
                                "Text":  [
                                             "{delay 1}A fresh face! You look like someone who appreciates a good weapon.",
                                             "{delay 1}I tinker. Starter guns, mostly. With the right parts I can make yours sing."
                                         ],
                                "Replies":  [
                                                "ask_parts",
                                                "ask_droids",
                                                "nothing"
                                            ]
                            }
              },
    "Trades":  {
                   "turnin_parts":  {
                                        "If":  [
                                                   "HasQuest DAPR"
                                               ],
                                        "Items":  [
                                                      {
                                                          "Hash":  "QPWS",
                                                          "Count":  1
                                                      },
                                                      {
                                                          "Hash":  "QSTL",
                                                          "Count":  1
                                                      },
                                                      {
                                                          "Hash":  "QRRI",
                                                          "Count":  1
                                                      }
                                                  ],
                                        "Goto":  "done_parts"
                                    }
               }
}