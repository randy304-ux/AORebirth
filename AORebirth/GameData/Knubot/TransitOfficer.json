                                                "StartAreaPending"
                                            ],
                                     "Goto":  "icc"
                                 },
                    "to_arete":  {
                                     "Text":  "Send me to Arete Landing.",
                                     "Goto":  "go_arete"
                                 },
                    "to_nascence":  {
                                        "Text":  "Send me to Nascence.",
                                        "Goto":  "go_nascence"
                                    },
                    "stay":  {
                                 "Text":  "Not now.",
                                 "Goto":  "bye"
                             },
                    "what_arete":  {
                                       "Text":  "What is Arete Landing?",
