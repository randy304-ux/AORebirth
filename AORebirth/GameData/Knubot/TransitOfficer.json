                                                  "StartAreaPending"
                                              ],
                                       "Goto":  "about"
                                   }
                },
    "Lines":  {
                  "go_arete":  {
                                   "Text":  [
                                                "Arete Landing it is.",
                                                "{delay 2}Hold still, the transfer beacon will pull you over now.{teleport 6553 3455 9.5 865}{close}"
                                            ]
                               },
                  "go_nascence":  {
                                      "Text":  [
                                                   "Nascence it is.",
                                                   "{delay 2}Hold still, the transfer beacon will pull you over now.{teleport 4313 412.8 76.7 353.5}{close}"
                                               ]
                                  },
                  "bye":  {
                              "Text":  "Come back whenever you need a transfer.{close}"
                          },
                  "travel":  {
                                 "Text":  "{delay 1}Need a transfer? I can send you to Arete Landing or to the Nascence Training Grounds.",
                                 "Replies":  [
                                                 "to_arete",
                                                 "to_nascence",
                                                 "stay"
                                             ]
                             },
                  "offer":  {
                                "Text":  [
                                             "{delay 1}Welcome to the ICC Shuttleport. I handle transfers for new arrivals.",
                                             "{delay 1}You can start your training right here, or I can send you to the colony camp on Arete Landing, or to Nascence in the Shadowlands. Any transit officer can move you between the three later."
                                         ],
                                "Replies":  [
                                                "go_arete",
                                                "go_nascence",
                                                "stay_icc",
                                                "what_arete"
                                            ]
                            },
                  "about":  {
                                "Text":  "Arete is the newer colony landing. The camp there has its own vendors and work for newcomers. The Shuttleport has Brandon Thorn and the classic island training.",
                                "Replies":  [
                                                "go_arete",
                                                "go_nascence",
                                                "stay_icc"
                                            ]
                            },
                  "arete":  {
                                "Text":  [
                                             "Arete Landing it is. Good luck out there!",
                                             "{delay 2}Hold still, the transfer beacon will pull you over now.{startarea arete}"
                                         ]
                            },
                  "nascence_start":  {
                                         "Text":  [
                                                      "Nascence it is. Good luck out there!",
                                                      "{delay 2}Hold still, the transfer beacon will pull you over now.{startarea icc}{teleport 4313 412.8 76.7 353.5}{close}"
                                                  ]
                                     },
                  "icc":  {
                              "Text":  "{startarea icc}Very well. Brandon Thorn right here will get you started. Welcome aboard!{close}"
                          }
