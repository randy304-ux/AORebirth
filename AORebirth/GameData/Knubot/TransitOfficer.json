                                     "If":  [
                                                "StartAreaPending"
                                            ],
                                     "Goto":  "arete"
                                 },
                    "go_nascence":  {
                                        "Text":  "Take me to Nascence.",
                                        "If":  [
                                                   "StartAreaPending"
                                               ],
                                        "Goto":  "nascence_start"
                                    },
                    "stay_icc":  {
