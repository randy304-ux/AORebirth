{
    "Notes":  "Dungeon Dogs ICC Transit Officer next to Brandon Thorn (PlayfieldContent 4582 Npcs.json). One-time start-area choice for new Rubi-Ka characters while pending ({startarea arete} moves to Arete Landing, {startarea icc} stays or goes on to Nascence), then travel to Arete Landing or Nascence any time. Generated by ddogs/tools/Build-TransitOfficers.ps1.",
    "Npcs":  [
                 "ddogs-icc-transit"
             ],
    "Openers":  [
                    {
                        "If":  [
                                   "StartAreaPending"
                               ],
                        "Say":  "offer"
                    },
                    {
                        "Say":  "travel"
                    }
                ],
