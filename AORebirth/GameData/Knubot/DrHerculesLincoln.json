  "Lines": {
    "hello": {
      "Text": "Omni-Tek needs a courier inside Biomare. Deliver this Systems Monthly to Efficiency Expert Linda Osmos and bring back her weekly progress report.",
      "Source": "filler",
      "Replies": [
        "start",
        "bye"
      ]
    },
    "start": {
      "Text": "Good. Take this periodical and find Linda Osmos inside Biomare.{givequest BM01}{spawn SYSM 1}",
      "Source": "filler",
      "Replies": [
        "bye"
      ]
    },
    "report": {
      "Text": "Do you have Linda's report?",
      "Source": "filler",
      "Replies": [
        "hand_report",
        "bye"
      ]
    },
    "hand_report": {
      "Text": "Excellent. Next problem: an analyst is hiding in the hangar. Take this Encryption Key and get her out.{completequest BM06}{givequest BM07}{spawn ENCK 1}",
      "Source": "filler",
      "Replies": [
        "bye"
      ]
    },
    "escort_offer": {
      "Text": "We still need that analyst extracted from the hangar.",
      "Source": "filler",
      "Replies": [
        "accept_escort",
        "bye"
      ]
    },
    "accept_escort": {
      "Text": "Find Theresa Cameron and get her to the emergency exit.{givequest BM07}{spawn ENCK 1}",
      "Source": "filler",
      "Replies": [
        "bye"
      ]
    },
    "datacube": {
