{
    "Notes":  "Janos, back of the Arete starting ship (playfield 7101). AO-Universe section 22, A Special Delivery. Bit 655. Generated by ddogs/tools/Build-NewbieQuests.ps1.",
    "Npcs":  [
                 "TPIB"
             ],
    "Openers":  [
                    {
                        "If":  [
                                   "HasAnyQuest JNSR"
                               ],
                        "Say":  "busy_parcel"
                    },
                    {
                        "Say":  "hello"
                    }
                ],
    "Replies":  {
                    "ask_parcel":  {
                                       "Text":  "I can take it.",
                                       "If":  [
                                                  "!HasCompletedQuest JNSR",
                                                  "!HasAnyQuest JNSR",
                                                  "minlevel 5"
                                              ],
                                       "Goto":  "offer_parcel"
                                   },
                    "take_parcel":  {
                                        "Text":  "I\u0027ll deliver it.",
                                        "If":  [
                                                   "!HasCompletedQuest JNSR",
                                                   "!HasAnyQuest JNSR",
                                                   "minlevel 5"
                                               ],
                                        "Goto":  "give_parcel"
                                    },
                    "later":  {
                                  "Text":  "Maybe later.",
                                  "Goto":  "later"
                              },
                    "bye":  {
                                "Text":  "I\u0027m on it.",
                                "Goto":  "bye"
                            },
                    "more":  {
                                 "Text":  "Anything else?",
                                 "Goto":  "hello"
                             },
                    "nothing":  {
                                    "Text":  "Nothing right now, thanks.",
                                    "Goto":  "nothing"
                                }
                },
    "Lines":  {
                  "offer_parcel":  {
                                       "Text":  [
                                                    "Leave with the blue android. Nobody else.",
                                                    "{delay 1}The parcel item is not in the item list, so I am not handing you a stand-in. When you are done on Arete, the Arrival Hall is in Andromeda. Turn right to the Holo Deck tower, take the telepad behind the reception desk, and give the errand to RALPH.",
                                                    "{delay 1}You cannot come back to Arete once you leave."
                                                ],
                                       "Replies":  [
                                                       "take_parcel",
                                                       "later"
                                                   ]
                                   },
                  "give_parcel":  {
                                      "Text":  [
                                                   "{givequest JNSR}",
                                                   "RALPH is upstairs in the Holo Deck. He is not expecting you."
                                               ]
                                  },
                  "busy_parcel":  {
                                      "Text":  "RALPH, the blue android in the Holo Deck at ICC Headquarters.",
                                      "Replies":  [
                                                      "bye"
                                                  ]
                                  },
                  "later":  {
                                "Text":  "Suit yourself. I\u0027ll be here.{close}"
                            },
                  "bye":  {
                              "Text":  "Good.{close}"
                          },
                  "nothing":  {
                                  "Text":  "Do not open it.{close}"
                              },
                  "hello":  {
                                "Text":  [
                                             "{delay 1}Janos. Are you heading to ICC Headquarters?",
                                             "{delay 1}I have a parcel for the robot butler at the desk in the tallest tower. It is marked for Arbiter Vincenzo Palmiero."
                                         ],
                                "Replies":  [
                                                "ask_parcel",
                                                "nothing"
                                            ]
                            }
              }
}