{
    "Notes":  "Stan Goodman, camp (3463x880). Guide: lockpick from ICC Tech, the strongbox, then four parts. 1240 credits, up to 2229 xp, Unprogrammed Identification Chip. Generated by ddogs/tools/Build-NewbieQuests.ps1.",
    "Npcs":  [
                 "SimpleChar:78E0FC65"
             ],
    "Openers":  [
                    {
                        "If":  [
                                   "HasQuest HSTG"
                               ],
                        "Say":  "arrive"
                    },
                    {
                        "If":  [
                                   "HasAnyQuest AST0,ASTR"
                               ],
                        "Say":  "busy_factory"
                    },
                    {
                        "Say":  "hello"
                    }
                ],
    "Replies":  {
                    "ask_factory":  {
                                        "Text":  "Alex sent me.",
                                        "If":  [
                                                   "!HasCompletedQuest ASTR",
                                                   "!HasAnyQuest AST0,ASTR",
                                                   "HasCompletedQuest AAXR"
                                               ],
                                        "Goto":  "offer_factory"
                                    },
                    "take_factory":  {
                                         "Text":  "Deal.",
                                         "If":  [
                                                    "!HasCompletedQuest ASTR",
                                                    "!HasAnyQuest AST0,ASTR",
                                                    "HasCompletedQuest AAXR"
                                                ],
                                         "Goto":  "give_factory"
                                     },
                    "handin_factory":  {
                                           "Text":  "I have it right here.",
                                           "If":  [
                                                      "HasQuest ASTR"
                                                  ],
                                           "Goto":  "handin_factory"
                                       },
                    "later":  {
                                  "Text":  "Maybe later.",
                                  "Goto":  "later"
                              },
                    "bye":  {
                                "Text":  "I\u0027m on it.",
                                "Goto":  "bye"
                            },
                    "more":  {
                                 "Text":  "Anything else?",
                                 "Goto":  "hello"
                             },
                    "nothing":  {
                                    "Text":  "Nothing right now, thanks.",
                                    "Goto":  "nothing"
                                },
                    "lost_pick":  {
                                      "Text":  "I lost my Lock Pick.",
                                      "If":  [
                                                 "HasQuest AST0",
                                                 "!has QLOK",
                                                 "!has BRAN"
                                             ],
                                      "Goto":  "regive_pick"
                                  }
                },
    "Lines":  {
                  "offer_factory":  {
                                        "Text":  [
                                                     "Buy a Vacuum Packed Lock Pick from ICC Tech Supplies if you do not have one. I will hand you one, because that counter is not stocked here.",
                                                     "{delay 1}Sneak past the security dog and lockpick the Merchant\u0027s Strongbox in the room at 3408 by 878. Bring me Antonio\u0027s Adaptation Factory, the Generic Nano Transmitter, the Blank Info Chip and the 2560-Bit Encryption Compiler."
                                                 ],
                                        "Replies":  [
                                                        "take_factory",
                                                        "later"
                                                    ]
                                    },
                  "give_factory":  {
                                       "Text":  [
                                                    "{spawn QLOK 1}",
                                                    "{givequest AST0}",
                                                    "{delay 1}Good luck. Come back to me when it is done."
                                                ]
                                   },
                  "done_factory":  {
                                       "Text":  [
                                                    "{completequest ASTR}",
                                                    "That is the set. The Unprogrammed Identification Chip is yours.",
                                                    "{givequest HMPS}",
                                                    "{delay 1}Marco Spida is in the camp, about 3408 by 831. He sells profession nanos."
                                                ],
                                       "Replies":  [
                                                       "more",
                                                       "nothing"
                                                   ]
                                   },
                  "handin_factory":  {
                                         "Text":  "Let\u0027s see it, then. Put it in the trade window.{opentrade}"
                                     },
                  "busy_factory":  {
                                       "Text":  "Lockpick the strongbox, then bring the factory, the transmitter, the info chip and the compiler.",
                                       "Replies":  [
                                                       "handin_factory",
                                                       "bye",
                                                       "lost_pick"
                                                   ]
                                   },
                  "later":  {
                                "Text":  "Suit yourself. I\u0027ll be here.{close}"
                            },
                  "bye":  {
                              "Text":  "Good.{close}"
                          },
                  "arrive":  {
                                 "Text":  [
                                              "{completequest HSTG}",
                                              "Alex sent you, did he?"
                                          ],
                                 "Replies":  [
                                                 "more",
                                                 "nothing"
                                             ]
                             },
                  "nothing":  {
                                  "Text":  "Stay sharp out there.{close}"
                              },
                  "hello":  {
                                "Text":  [
                                             "{delay 1}Stan Goodman, purveyor of recently used merchandise."
                                         ],
                                "Replies":  [
                                                "ask_factory",
                                                "nothing"
                                            ]
                            },
                  "regive_pick":  {
                                      "Text":  [
                                                   "{spawn QLOK 1}",
                                                   "Here is another Vacuum Packed Lock Pick. Use the lock pick on the strongbox itself, do not hand it to anyone."
                                               ],
                                      "Replies":  [
                                                      "bye"
                                                  ]
                                  }
              },
    "Trades":  {
                   "turnin_factory":  {
                                          "If":  [
