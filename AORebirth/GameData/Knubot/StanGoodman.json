                                                 ],
                                          "Items":  [
                                                        {
                                                            "Hash":  "QAAF",
                                                            "Count":  1
                                                        },
                                                        {
                                                            "Hash":  "QGNT",
                                                            "Count":  1
                                                        },
                                                        {
                                                            "Hash":  "QBIC",
                                                            "Count":  1
                                                        },
                                                        {
                                                            "Hash":  "QENC",
                                                            "Count":  1
                                                        }
                                                    ],
                                          "Goto":  "done_factory"
                                      }
               }
}
