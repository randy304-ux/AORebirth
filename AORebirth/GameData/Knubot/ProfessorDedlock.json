    "offer_clan": {
      "Text": "Clan applicants hunt Tempterus at Papageno's Paradise in Nascence Frontier (650,1275). Thirty kills; Hai-Tempterus do not count. The Mariner's Father is waiting in your inventory when you are done. Bring it back to me.",
      "Source": "filler",
      "Replies": [
        "take_tempt",
        "later"
      ]
    },
    "offer_omni": {
      "Text": "Omni applicants hunt Hai-Tempterus at Papagena's Paradise in Nascence Frontier (950,1270). Thirty kills; Tempterus do not count. The Mariner's Father is waiting in your inventory when you are done. Bring it back to me.",
      "Source": "filler",
      "Replies": [
        "take_hai",
        "later"
      ]
    },
    "offer_neutral": {
      "Text": "Neutral applicants may choose: thirty Tempterus at Papageno's Paradise (650,1275) or thirty Hai-Tempterus at Papagena's Paradise (950,1270), both in Nascence Frontier. The Mariner's Father is waiting in your inventory when you are done.",
      "Source": "filler",
      "Replies": [
        "take_tempt_n",
        "take_hai_n",
        "later"
      ]
    },
    "give_clan": {
      "Text": "{givequest NA2J}The hunt is in your journal.{close}",
      "Source": "filler"
    },
    "give_omni": {
      "Text": "{givequest NA2K}The hunt is in your journal.{close}",
      "Source": "filler"
    },
    "hunt_busy": {
      "Text": "Keep at it. Thirty kills; the book appears in your inventory on the last one. Tempterus for Clan, Hai-Tempterus for Omni.",
      "Source": "filler",
      "Replies": [
        "bye"
      ]
    },
    "about": {
      "Text": "A specialization book is four parts: collect the chapters (or editions, or volumes) and combine them in order 1, 2, 3, 4. Hand the finished book to me, in order: The Mariner's Father, The Girl that Saw it All, Kanel's Story, then Afirce's World Catalogue of Books.",
      "Source": "filler",
      "Replies": [
        "bye"
      ]
    },
