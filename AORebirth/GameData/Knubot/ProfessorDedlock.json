  "Lines": {
    "hello": {
      "Text": "This person seems to have been studying you for a while before you entered conversation with him. A large badge on his chest reads: \"Professor Jo Dedlock, JAME\"",
      "Source": "captured",
      "Replies": [
        "give",
        "cyber",
        "bye"
      ]
    },
    "offer_clan": {
      "Text": "Clan applicants hunt Tempterus at Papageno's Paradise in Nascence Frontier (650,1275). Thirty kills; Hai-Tempterus do not count. The Mariner's Father is waiting in your inventory when you are done. Bring it back to me.",
      "Source": "filler",
      "Replies": [
        "take_tempt",
        "later"
      ]
    },
    "offer_omni": {
      "Text": "Omni applicants hunt Hai-Tempterus at Papagena's Paradise in Nascence Frontier (950,1270). Thirty kills; Tempterus do not count. The Mariner's Father is waiting in your inventory when you are done. Bring it back to me.",
      "Source": "filler",
      "Replies": [
        "take_hai",
        "later"
      ]
    },
    "offer_neutral": {
      "Text": "Neutral applicants may choose: thirty Tempterus at Papageno's Paradise (650,1275) or thirty Hai-Tempterus at Papagena's Paradise (950,1270), both in Nascence Frontier. The Mariner's Father is waiting in your inventory when you are done.",
      "Source": "filler",
      "Replies": [
        "take_tempt_n",
        "take_hai_n",
        "later"
      ]
    },
    "give_clan": {
      "Text": "{givequest NA2J}The hunt is in your journal.{close}",
      "Source": "filler"
    },
    "give_omni": {
      "Text": "{givequest NA2K}The hunt is in your journal.{close}",
      "Source": "filler"
    },
    "hunt_busy": {
      "Text": "Keep at it. Thirty kills; the book appears in your inventory on the last one. Tempterus for Clan, Hai-Tempterus for Omni.",
      "Source": "filler",
      "Replies": [
        "bye"
      ]
    },
    "about": {
      "Text": "A specialization book is four parts: collect the chapters (or editions, or volumes) and combine them in order 1, 2, 3, 4. Hand the finished book to me, in order: The Mariner's Father, The Girl that Saw it All, Kanel's Story, then Afirce's World Catalogue of Books.",
      "Source": "filler",
      "Replies": [
        "bye"
      ]
    },
    "give_t1": {
      "Text": "Put the book in the trade window.{givequest NA2M}{opentrade}",
      "Source": "filler"
    },
    "done_t1": {
      "Text": "{completequest NA2M}Excellent work. Specialization 1 is yours.{close}",
      "Source": "filler"
    },
    "done_t1_nt": {
      "Text": "{completequest NA2M}{spawn NDK1 1}Excellent work. Specialization 1 is yours. As a Nano-Technician you also receive an Unattuned Basic Cyberdeck. Use it to attune it to your breed and gender; it can be equipped from level 50.{close}",
      "Source": "filler"
    },
    "give_t2": {
      "Text": "Put the book in the trade window.{givequest NA2N}{opentrade}",
      "Source": "filler"
    },
    "done_t2": {
      "Text": "{completequest NA2N}Excellent work. Specialization 2 is yours.{close}",
      "Source": "filler"
    },
    "done_t2_nt": {
      "Text": "{completequest NA2N}{spawn NDK2 1}Excellent work. Specialization 2 is yours. As a Nano-Technician you also receive an Unattuned Augmented Cyberdeck. Use it to attune it to your breed and gender; it can be equipped from level 100.{close}",
      "Source": "filler"
    },
    "give_t3": {
      "Text": "Put the book in the trade window.{givequest NA2O}{opentrade}",
      "Source": "filler"
    },
    "done_t3": {
      "Text": "{completequest NA2O}Excellent work. Specialization 3 is yours.{close}",
      "Source": "filler"
    },
    "done_t3_nt": {
      "Text": "{completequest NA2O}{spawn NDK3 1}Excellent work. Specialization 3 is yours. As a Nano-Technician you also receive an Unattuned Jobe-chipped Cyberdeck. Use it to attune it to your breed and gender; it can be equipped from level 150.{close}",
      "Source": "filler"
    },
    "give_t4": {
      "Text": "Put the book in the trade window.{givequest NA2P}{opentrade}",
      "Source": "filler"
    },
    "done_t4": {
      "Text": "{completequest NA2P}Excellent work. Specialization 4 is yours.{close}",
      "Source": "filler"
    },
    "done_t4_nt": {
      "Text": "{completequest NA2P}{spawn NDK4 1}Excellent work. Specialization 4 is yours. As a Nano-Technician you also receive an Unattuned Izgimmer-modified Cyberdeck. Use it to attune it to your breed and gender; it can be equipped from level 200.{close}",
      "Source": "filler"
    },
    "later": {
      "Text": "As you wish.{close}",
      "Source": "filler"
    },
    "bye": {
      "Text": "Good luck!{close}",
      "Source": "captured close text"
    },
