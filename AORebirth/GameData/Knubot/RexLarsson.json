{
    "Notes":  "Rex Larsson, cleaning business on the upper deck (3624x788). Identity Crisis start. Generated by ddogs/tools/Build-NewbieQuests.ps1.",
    "Npcs":  [
                 "SimpleChar:78E0FC63"
             ],
    "Openers":  [
                    {
                        "If":  [
                                   "HasQuest ARXR"
                               ],
                        "Say":  "done_robots"
                    },
                    {
                        "If":  [
                                   "HasAnyQuest ARX0,ARXR"
                               ],
                        "Say":  "busy_robots"
                    },
                    {
                        "Say":  "hello"
                    }
                ],
    "Replies":  {
                    "ask_robots":  {
                                       "Text":  "What\u0027s wrong with the robots?",
                                       "If":  [
                                                  "!HasCompletedQuest ARXR",
                                                  "!HasAnyQuest ARX0,ARXR"
                                              ],
                                       "Goto":  "offer_robots"
                                   },
                    "take_robots":  {
                                        "Text":  "I\u0027ll take care of them.",
                                        "If":  [
                                                   "!HasCompletedQuest ARXR",
                                                   "!HasAnyQuest ARX0,ARXR"
                                               ],
                                        "Goto":  "give_robots"
                                    },
                    "later":  {
                                  "Text":  "Maybe later.",
                                  "Goto":  "later"
                              },
                    "bye":  {
                                "Text":  "I\u0027m on it.",
                                "Goto":  "bye"
                            },
                    "more":  {
                                 "Text":  "Anything else?",
                                 "Goto":  "hello"
                             },
                    "nothing":  {
                                    "Text":  "Nothing right now, thanks.",
                                    "Goto":  "nothing"
                                }
                },
    "Lines":  {
                  "offer_robots":  {
                                       "Text":  [
                                                    "Five of my Malfunctioning Cleaning Robots are rolling around out here, scrubbing anything that moves. Terminate them.",
                                                    "{delay 1}Come back when they\u0027re scrap and I\u0027ll introduce you to someone useful."
                                                ],
                                       "Replies":  [
                                                       "take_robots",
                                                       "later"
                                                   ]
                                   },
                  "give_robots":  {
                                      "Text":  [
                                                   "{givequest ARX0}",
                                                   "{delay 1}Good luck. Come back to me when it is done."
                                               ]
                                  },
                  "done_robots":  {
                                      "Text":  [
                                                   "{completequest ARXR}",
                                                   "Ha! Much quieter. Thanks.",
                                                   "{givequest HFLN}",
                                                   "{delay 1}Now go see Flint Novak, down by the junkyard. He knows people who can build you that ID."
                                               ],
                                      "Replies":  [
                                                      "more",
                                                      "nothing"
                                                  ]
                                  },
                  "busy_robots":  {
                                      "Text":  "Five Malfunctioning Cleaning Robots, right around here.",
                                      "Replies":  [
                                                      "bye"
                                                  ]
                                  },
                  "later":  {
                                "Text":  "Suit yourself. I\u0027ll be here.{close}"
                            },
                  "bye":  {
                              "Text":  "Good.{close}"
                          },
                  "nothing":  {
                                  "Text":  "Keep your head down out there.{close}"
                              },
                  "hello":  {
                                "Text":  [
                                             "{delay 1}You look new. Everyone who washes up here wants the same thing: an ID, so they can get off Arete and onto Rubi-Ka proper.",
                                             "{delay 1}I can point you to the people who make that happen. But first, a favor. My cleaning robots have gone haywire."
                                         ],
                                "Replies":  [
                                                "ask_robots",
                                                "nothing"
                                            ]
                            }
              }
}