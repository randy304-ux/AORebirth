{
  "Npcs": [
    "OWPT"
  ],
  "Openers": [
    {
      "If": [
        "quest AO00 none"
      ],
      "Say": "offer"
    },
    {
      "If": [
        "quest AO00 active"
      ],
      "Say": "progress"
    },
    {
      "If": [
        "quest AO00 done"
      ],
      "Say": "done"
    }
  ],
  "Lines": {
    "offer": {
      "Text": "Hello young one. Welcome to Adonis.",
      "Replies": [
        "who",
        "start",
        "bye"
      ],
      "Source": "capture"
    },
    "whoami": {
      "Text": "I am One Who Points the Way. One Who Greets Wanderers waits in the Adonis Hallway, near 126 by 129. I can set you on that path.",
      "Replies": [
        "start",
        "bye"
      ],
      "Source": "filler"
    },
    "accept": {
      "Text": "Go to One Who Greets Wanderers in the Adonis Hallway, then return along the Xan trail. {givequest AO00}",
      "Replies": [
        "bye"
      ],
      "Source": "filler"
    },
    "progress": {
      "Text": "One Who Greets Wanderers still waits in the Adonis Hallway.",
      "Replies": [
        "bye"
      ],
      "Source": "filler"
    },
    "done": {
      "Text": "You have started. Follow the Xan path.",
      "Replies": [
        "bye"
      ],
      "Source": "filler"
    }
  },
  "Replies": {
    "who": {
      "Text": "Who are you?",
      "Goto": "whoami",
      "Source": "capture"
    },
    "start": {
      "Text": "I will help.",
      "Goto": "accept",
      "Source": "filler"
    },
    "bye": {
      "Text": "Goodbye",
      "Goto": "close",
      "Source": "capture"
    }
  }
}
